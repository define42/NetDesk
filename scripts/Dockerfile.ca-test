FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk add --no-cache ca-certificates curl dhcpcd dhcpcd-openrc nss-tools openssl python3 su-exec \
    && adduser -D -u 1000 netdesk \
    && touch /netdesk-ca-test-container

WORKDIR /src
ENTRYPOINT ["python3", "/src/scripts/test-ca.py", "--in-container"]
