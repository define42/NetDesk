#!/sbin/openrc-run
# OpenRC reads these service configuration variables.
# shellcheck disable=SC2034

description="NetDesk graphical desktop"
supervisor="supervise-daemon"
command="/usr/local/bin/netdesk-xserver"
command_user="root:root"
directory="/home/netdesk"
output_log="/var/log/netdesk-session.log"
error_log="/var/log/netdesk-session.log"
respawn_delay=3
respawn_max=5
respawn_period=60

depend() {
    need dbus udev-settle
    after bootmisc dhcpcd
}

start_pre() {
    checkpath --directory --mode 0755 /run/user || return 1
    checkpath --directory --owner root:root --mode 0700 /run/netdesk || return 1
    checkpath --directory --owner netdesk:netdesk --mode 0700 /run/user/1000 || return 1
    checkpath --directory --owner root:root --mode 1777 /tmp/.X11-unix || return 1
    checkpath --file --owner root:root --mode 0644 /var/log/netdesk-session.log || return 1
}

start_post() {
    # Confirm an authenticated X display, active monitor, XFCE window manager,
    # panel, desktop and settings daemon before declaring the desktop ready.
    attempt=0
    while [ "$attempt" -lt 90 ]; do
        if timeout 3 su-exec netdesk:netdesk env \
            DISPLAY=:0 XAUTHORITY=/run/user/1000/Xauthority \
            /usr/local/bin/netdesk-desktop-ready 2>/dev/null; then
            printf '%s\n' 'NetDesk desktop ready' > /dev/console
            return 0
        fi
        attempt=$((attempt + 1))
        sleep 1
    done
    eerror "XFCE did not become ready; see /var/log/netdesk-session.log and /var/log/Xorg.0.log"
    return 1
}
